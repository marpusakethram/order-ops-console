# ============================================================================
# Order Ops Console - Environment Configuration (.env.example)
# ============================================================================
# Copy this file to .env if you want to customize local settings or enable
# Connected Mode (Supabase PostgreSQL + Gemini API).
#
# For Demo Mode, NO .env file or credentials are required!
# ============================================================================

# 1. Application Mode
# Set to "demo" (default) to use local SQLite and allow instant demo loading.
# Set to "connected" when connecting to Supabase PostgreSQL for real team data.
APP_MODE=demo

# Default workspace identifier used in local/demo mode
DEFAULT_WORKSPACE_ID=demo-workspace

# Reference time mode:
# - "demo_fixed": Uses DEMO_REFERENCE_TIME so time-based attention rules
#   (like "no tracking update for 3 days") remain consistent on any future date.
# - "live_ist": Uses the current wall-clock time in Asia/Kolkata (IST).
REFERENCE_TIME_MODE=demo_fixed
DEMO_REFERENCE_TIME=2026-10-19T18:00:00+05:30

# 2. Database Configuration
# Leave blank in demo mode to automatically use local SQLite at:
#   data/order_ops_console.db
# For Supabase PostgreSQL (Connected Mode), provide the connection URI:
#   postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# 3. Optional Supabase Project Settings (for Connected Mode & JWT Auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Used server-side to verify Supabase Auth JWT bearer tokens when REQUIRE_AUTH=true
SUPABASE_JWT_SECRET=

# 4. Authentication & Access Control
# In Demo Mode, authentication is optional so you can test immediately.
# Set REQUIRE_AUTH=true in hosted/connected mode to require either a valid
# Supabase Auth Bearer JWT or the configured APP_ACCESS_TOKEN header (X-Ops-Token).
REQUIRE_AUTH=false
APP_ACCESS_TOKEN=

# Maximum CSV upload size in megabytes (default: 10 MB)
MAX_UPLOAD_SIZE_MB=10

# 5. Optional Gemini API Configuration (for "Ask Your Orders")
# Leave GEMINI_API_KEY blank to use the built-in deterministic query parser.
# When provided, Gemini translates natural-language questions into a validated
# structured filter schema (never raw SQL).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=8

# 6. Default Operational Thresholds
# Hours before an unshipped order is flagged as delayed (default: 48 hours = 2 days)
THRESHOLD_UNSHIPPED_HOURS=48
# Hours without a courier scan before an in-transit shipment is flagged as stale (default: 72 hours = 3 days)
THRESHOLD_STALE_TRACKING_HOURS=72
